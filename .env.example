# ============================================================== 
# AI News YouTube Pipeline - Environment Variables
# Copy this to .env and fill in your keys.
# ============================================================== 

# === REQUIRED: LLM ===
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxx

# === OPTIONAL: Fallback LLM ===
OPENROUTER_API_KEY=

# === YOUTUBE UPLOAD (OAuth) ===
# 1. Create project at console.cloud.google.com
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Download client_secrets.json -> config/client_secrets.json
# 5. Run: python scripts/auth_youtube.py
# 6. Copy refresh_token below
YOUTUBE_CLIENT_ID=xxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxx

# === TELEGRAM NOTIFICATIONS (Recommended) ===
# 1. Message @BotFather on Telegram -> /newbot
# 2. Message your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find YOUR chat ID (not the bot's ID from the token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === PIPELINE SETTINGS ===
VIDEOS_PER_DAY=2
PIPELINE_RUN_HOURS=6,14
AUTO_UPLOAD=false
REVIEW_BEFORE_UPLOAD=false
CONTENT_MODERATION_STRICT=true
MAX_ARTICLES_PER_RUN=50
REQUIRE_HUMAN_REVIEW=false

# === TTS ===
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-ChristopherNeural

# === IMAGE GENERATION ===
IMAGE_PROVIDER=pollinations
TOGETHER_API_KEY=

# === DATABASE ===
DATABASE_PATH=news_pipeline.db

# === OPTIONAL: Turso Cloud DB (for dashboard) ===
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# === OPTIONAL: Discord ===
DISCORD_WEBHOOK_URL=
